<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sphere_stereo_ros</name>
  <version>1.0.0</version>
  <description>
    Real-Time Sphere Sweeping Stereo from Multiview Fisheye Images.
    ROS 2 package ported from Python/PyTorch implementation.
    Based on: Meuleman et al., CVPR 2021
  </description>
  <maintainer email="motoken@example.com">motoken</maintainer>
  <license>CC-BY-NC-SA-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- cv_bridge enabled for ROS 2 node -->
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <!-- External dependencies -->
  <build_depend>eigen</build_depend>
  <build_depend>OpenCV</build_depend>
  
  <exec_depend>eigen</exec_depend>
  <exec_depend>OpenCV</exec_depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
